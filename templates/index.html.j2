<script>
/* Two small enhancements, both optional. With JS off the audit table still
   opens and closes and every row is present and unfiltered; only the filter
   chips and the rail highlight degrade. Nothing here touches the network. */
(function () {
  "use strict";

  // ---- audit table filter chips ----------------------------------------
  var details = document.querySelector(".audit-x");
  var body = document.querySelector("[data-audit-body]");
  var live = document.querySelector("[data-live]");
  var chips = document.querySelectorAll(".filters button[data-filter]");

  if (body && live) {
    var rows = Array.prototype.slice.call(body.rows);
    var total = rows.length;

    function apply(filter, probe) {
      var shown = 0;
      rows.forEach(function (tr) {
        var ok = true;
        if (probe) {
          ok = tr.getAttribute("data-probe") === probe;
        } else if (filter && filter !== "all") {
          var parts = filter.split(":");
          var attr = parts[0] === "sys" ? "data-sys" : "data-verdict";
          ok = tr.getAttribute(attr) === parts[1];
        }
        tr.classList.toggle("hidden", !ok);
        if (ok) shown++;
      });
      live.textContent = probe
        ? shown + " of " + total + " rows · probe " + probe
        : shown + " of " + total + " rows";
    }

    Array.prototype.forEach.call(chips, function (btn) {
      btn.addEventListener("click", function () {
        Array.prototype.forEach.call(chips, function (b) { b.classList.remove("on"); });
        btn.classList.add("on");
        apply(btn.getAttribute("data-filter"), null);
      });
    });

    // Evidence chips in Step 3 are the one case where auto-opening is right:
    // the reader asked for specific rows.
    Array.prototype.forEach.call(
      document.querySelectorAll("[data-probe-link]"),
      function (link) {
        link.addEventListener("click", function () {
          var probe = link.getAttribute("data-probe-link");
          if (details) details.open = true;
          Array.prototype.forEach.call(chips, function (b) { b.classList.remove("on"); });
          apply(null, probe);
        });
      }
    );

    if (details) {
      var collapse = details.querySelector("[data-collapse-audit]");
      if (collapse) {
        collapse.addEventListener("click", function () {
          details.open = false;
          details.scrollIntoView({ block: "start" });
        });
      }
    }
  }

  // ---- step rail highlight ---------------------------------------------
  var links = document.querySelectorAll(".step-rail a[data-rail]");
  if (links.length && "IntersectionObserver" in window) {
    var byId = {};
    Array.prototype.forEach.call(links, function (a) {
      byId[a.getAttribute("data-rail")] = a;
    });
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          Array.prototype.forEach.call(links, function (a) { a.classList.remove("on"); });
          var current = byId[entry.target.id];
          if (current) current.classList.add("on");
        });
      },
      { rootMargin: "-45% 0px -45% 0px" }
    );
    Object.keys(byId).forEach(function (id) {
      var section = document.getElementById(id);
      if (section) observer.observe(section);
    });
  }
})();
</script>

